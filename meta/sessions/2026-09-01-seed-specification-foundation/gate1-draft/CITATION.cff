    affiliation: "Context&"
repository-code: "https://github.com/Hafeok/specification-foundation"
license: CC-BY-4.0
license-url: "https://creativecommons.org/licenses/by/4.0/"
keywords:
  - specification
  - actor-indexed determination
  - decision-driven design
  - completeness
  - act vocabulary
date-released: "2026-09-01"

